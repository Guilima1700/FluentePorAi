# Endereço público principal, incluindo https:// e sem caminho.
# Depois de conectar o domínio na Vercel, configure essa variável em Production e faça Redeploy.
NEXT_PUBLIC_SITE_URL=https://fluenteporai.com.br
# Token opcional fornecido pelo Google Search Console para verificação por meta tag.
# A verificação por propriedade Domínio usa um registro TXT no DNS e dispensa esta variável.
GOOGLE_SITE_VERIFICATION=
